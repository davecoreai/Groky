# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MIDTRANS PAYMENT GATEWAY (PRODUCTION)
# Dapatkan Server Key (Secret Key) dan Client Key dari Dashboard Midtrans: https://dashboard.midtrans.com/settings/access_keys
MIDTRANS_SERVER_KEY="Mid-server-xxxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="Mid-client-xxxxxxxxxxxxxxxxx"
MIDTRANS_MERCHANT_ID="Gxxxxxxxx"
MIDTRANS_IS_PRODUCTION="true"

# Client-side exposed Midtrans Client Key (optional, can also be retrieved via /api/payment/midtrans/config)
VITE_MIDTRANS_CLIENT_KEY="Mid-client-xxxxxxxxxxxxxxxxx"
VITE_MIDTRANS_IS_PRODUCTION="true"
