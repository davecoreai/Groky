# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL(s) where this app is hosted.
# Supported Production Domains:
# 1) https://groky-seven.vercel.app
# 2) https://grokyai.web.id
APP_URL="https://groky-seven.vercel.app, https://grokyai.web.id"

# OpenRouter API Key for unified AI model streaming
OPENROUTER_API_KEY=""

# Groq API Console Key for high-speed OpenAI open-source models (Groky 3.1 Lite & Groky 3.5 Pro)
GROQ_API_KEY=""

# Supabase database configuration for persistent conversations & message history
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
